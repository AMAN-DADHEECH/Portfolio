# ==========================================
# CONTACT FORM SMTP CONFIGURATION (GMAIL)
# ==========================================
# Your Gmail address that will send the dispatch notification
SMTP_USER=work.amandadheech2005@gmail.com

# 16-character Google App Password (NOT your normal Gmail password!)
# How to get it:
# 1. Go to your Google Account (https://myaccount.google.com/)
# 2. Click "Security" -> Ensure "2-Step Verification" is ON
# 3. Search for "App Passwords" (or visit https://myaccount.google.com/apppasswords)
# 4. Create an app named "Portfolio Contact", and copy the 16-character password generated
SMTP_PASS=your_16_character_google_app_password

# The email address where messages should be delivered
CONTACT_RECEIVER_EMAIL=work.amandadheech2005@gmail.com
